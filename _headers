/partials/*
  X-Robots-Tag: noindex

/archive/*
  X-Robots-Tag: noindex

/data/pages.json
  Cache-Control: no-store, no-cache, must-revalidate

/data/new-articles.json
  Cache-Control: no-store, no-cache, must-revalidate

/data/release-guard.json
  Cache-Control: no-store, no-cache, must-revalidate

/data/saguchi-related.json
  Cache-Control: no-store

/*
  Referrer-Policy: same-origin

/data/search/manifest.json
  Cache-Control: no-store, no-cache, must-revalidate

/data/search/metadata.*.json
  Cache-Control: public, max-age=31536000, immutable

/data/search/grams/*
  Cache-Control: public, max-age=31536000, immutable

/data/search/bodies/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/article-search.js
  Cache-Control: no-store

/assets/js/search-core.js
  Cache-Control: no-store

/assets/js/search-worker.js
  Cache-Control: no-store

/assets/js/search-preferences.js
  Cache-Control: no-store

/assets/js/home-search.js
  Cache-Control: no-store

/assets/css/article-search.css
  Cache-Control: no-store

/assets/css/site-header.css
  Cache-Control: no-store
